// =============================================================================
// ANAJ — PostgreSQL Schema (Prisma)
// Design principles:
//   - UUIDs for all externally exposed IDs
//   - Decimal types for all monetary and weight values
//   - Separate quantity fields for each procurement stage
//   - Purchase terms locked at acceptance (not re-read from current rates)
//   - Status transitions enforced in application logic + DB constraints
//   - Timestamps stored in UTC; formatted on client per locale
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Language {
  HI
  EN
}

enum UserRole {
  OWNER
  ADMIN
  PROCUREMENT_MANAGER
  COLLECTION_STAFF
  QUALITY_INSPECTOR
  ACCOUNTS_STAFF
}

enum Unit {
  KG
  QUINTAL
}

enum SellRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  COLLECTION_SCHEDULED
  COLLECTED
  QUALITY_CHECK
  WEIGHED
  APPROVED_FOR_PAYMENT
  PARTIALLY_PAID
  PAID
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum CollectionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum QualityResult {
  PASSED
  FAILED
  CONDITIONAL
}

// ---------------------------------------------------------------------------
// Staff Users (admin website accounts)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(100)
  email        String?  @unique @db.VarChar(255)
  phone        String   @unique @db.VarChar(15)
  passwordHash String?  @db.VarChar(255)
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)
  language     Language @default(HI)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  createdRates      PurchaseRate[]    @relation("RateCreatedBy")
  processedRequests SellRequest[]     @relation("RequestProcessedBy")
  auditLogs         AuditLog[]
  farmerNotes       FarmerNote[]
  payments          Payment[]         @relation("PaymentRecordedBy")
  collectionAssignments Collection[]  @relation("CollectionAssignedTo")

  @@index([email])
  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Farmers (mobile app accounts — authenticated via OTP, not password)
// ---------------------------------------------------------------------------

model Farmer {
  id              String   @id @default(uuid())
  phone           String   @unique @db.VarChar(15)
  name            String   @db.VarChar(100)
  profilePhotoUrl String?  @db.VarChar(1000)
  isVerified      Boolean  @default(false)
  isActive        Boolean  @default(true)
  language        Language @default(HI)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  address       FarmerAddress?
  sellRequests  SellRequest[]
  deviceTokens  DeviceToken[]
  notifications Notification[]
  notes         FarmerNote[]

  @@index([phone])
  @@index([isActive])
  @@map("farmers")
}

model FarmerAddress {
  id          String @id @default(uuid())
  farmerId    String @unique
  village     String @db.VarChar(100)
  postOffice  String @db.VarChar(100)
  district    String @db.VarChar(100)
  state       String @db.VarChar(100)
  pinCode     String @db.VarChar(6)

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([district])
  @@index([pinCode])
  @@map("farmer_addresses")
}

// ---------------------------------------------------------------------------
// OTP Records (never stores plaintext OTP)
// ---------------------------------------------------------------------------

model OtpRecord {
  id        String   @id @default(uuid())
  phone     String   @db.VarChar(15)
  otpHash   String   @db.VarChar(255) // bcrypt hash — never plaintext
  expiresAt DateTime
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
  @@map("otp_records")
}

// ---------------------------------------------------------------------------
// Refresh Tokens
// ---------------------------------------------------------------------------

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(512) // hashed token
  farmerId  String?
  userId    String?
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([farmerId])
  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------

model Product {
  id           String   @id @default(uuid())
  slug         String   @unique @db.VarChar(100)
  imageUrl     String?  @db.VarChar(1000)
  isActive     Boolean  @default(true)
  allowedUnits Unit[]
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  translations ProductTranslation[]
  rates        PurchaseRate[]
  sellRequests SellRequest[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("products")
}

model ProductTranslation {
  id          String   @id @default(uuid())
  productId   String
  language    Language
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, language])
  @@map("product_translations")
}

// ---------------------------------------------------------------------------
// Purchase Rates
// Rate history is preserved. The rate locked on a SellRequest at acceptance
// is stored directly on the request (agreedRatePerQuintal) so it never
// changes even if the current rate is later updated.
// ---------------------------------------------------------------------------

model PurchaseRate {
  id             String    @id @default(uuid())
  productId      String
  ratePerQuintal Decimal   @db.Decimal(10, 2)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  isActive       Boolean   @default(true)
  notes          String?   @db.VarChar(500)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  product     Product       @relation(fields: [productId], references: [id])
  createdBy   User          @relation("RateCreatedBy", fields: [createdById], references: [id])
  sellRequests SellRequest[] @relation("AgreedRate")

  @@index([productId, isActive])
  @@index([effectiveFrom])
  @@map("purchase_rates")
}

// ---------------------------------------------------------------------------
// Sell Requests
// ---------------------------------------------------------------------------

model SellRequest {
  id        String            @id @default(uuid())
  reference String            @unique @db.VarChar(20) // e.g. ANJ-2024-001234
  farmerId  String
  productId String
  status    SellRequestStatus @default(SUBMITTED)

  // Quantity at each stage (separate columns, never overwritten)
  requestedQuantity Decimal  @db.Decimal(10, 3)
  requestedUnit     Unit
  acceptedQuantity  Decimal? @db.Decimal(10, 3)
  collectedQuantity Decimal? @db.Decimal(10, 3)
  finalQuantity     Decimal? @db.Decimal(10, 3)

  // Pricing — locked at acceptance
  expectedPricePerQuintal  Decimal? @db.Decimal(10, 2)
  agreedRateId             String?
  agreedRatePerQuintal     Decimal? @db.Decimal(10, 2) // locked copy
  applicableDeductions     Decimal? @db.Decimal(10, 2)
  finalPayableAmount       Decimal? @db.Decimal(12, 2)

  // Logistics
  collectionAddress       String?  @db.VarChar(500)
  preferredCollectionDate DateTime?
  quality                 String?  @db.VarChar(500)
  notes                   String?  @db.VarChar(1000)

  // Admin processing
  processedById  String?
  rejectionReason String? @db.VarChar(500)

  // Idempotency — prevents duplicate mobile submissions
  clientRequestId String? @unique @db.VarChar(36)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farmer            Farmer             @relation(fields: [farmerId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  agreedRate        PurchaseRate?      @relation("AgreedRate", fields: [agreedRateId], references: [id])
  processedBy       User?              @relation("RequestProcessedBy", fields: [processedById], references: [id])
  photos            SellRequestPhoto[]
  collection        Collection?
  qualityInspection QualityInspection?
  weighment         Weighment?
  purchaseOrder     PurchaseOrder?
  payments          Payment[]

  @@index([farmerId])
  @@index([status])
  @@index([productId])
  @@index([createdAt])
  @@index([reference])
  @@map("sell_requests")
}

model SellRequestPhoto {
  id            String   @id @default(uuid())
  sellRequestId String
  url           String   @db.VarChar(1000)
  uploadedAt    DateTime @default(now())

  sellRequest SellRequest @relation(fields: [sellRequestId], references: [id], onDelete: Cascade)

  @@index([sellRequestId])
  @@map("sell_request_photos")
}

// ---------------------------------------------------------------------------
// Collection
// ---------------------------------------------------------------------------

model Collection {
  id              String           @id @default(uuid())
  sellRequestId   String           @unique
  scheduledDate   DateTime
  actualDate      DateTime?
  address         String           @db.VarChar(500)
  assignedStaffId String?
  status          CollectionStatus @default(SCHEDULED)
  notes           String?          @db.VarChar(1000)
  cancelReason    String?          @db.VarChar(500)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  sellRequest    SellRequest @relation(fields: [sellRequestId], references: [id])
  assignedStaff  User?       @relation("CollectionAssignedTo", fields: [assignedStaffId], references: [id])

  @@index([scheduledDate])
  @@index([status])
  @@map("collections")
}

// ---------------------------------------------------------------------------
// Quality Inspection
// ---------------------------------------------------------------------------

model QualityInspection {
  id              String         @id @default(uuid())
  sellRequestId   String         @unique
  grade           String?        @db.VarChar(50)
  moisturePercent Decimal?       @db.Decimal(5, 2)
  notes           String?        @db.VarChar(1000)
  inspectedById   String?
  result          QualityResult?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  sellRequest SellRequest @relation(fields: [sellRequestId], references: [id])

  @@map("quality_inspections")
}

// ---------------------------------------------------------------------------
// Weighment
// ---------------------------------------------------------------------------

model Weighment {
  id            String   @id @default(uuid())
  sellRequestId String   @unique
  grossWeightKg Decimal? @db.Decimal(10, 3)
  tareWeightKg  Decimal? @db.Decimal(10, 3)
  netWeightKg   Decimal? @db.Decimal(10, 3)
  weighedById   String?
  notes         String?  @db.VarChar(1000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sellRequest SellRequest          @relation(fields: [sellRequestId], references: [id])
  deductions  WeighmentDeduction[]

  @@map("weighments")
}

model WeighmentDeduction {
  id          String  @id @default(uuid())
  weighmentId String
  reason      String  @db.VarChar(200)
  amountKg    Decimal @db.Decimal(10, 3)

  weighment Weighment @relation(fields: [weighmentId], references: [id], onDelete: Cascade)

  @@map("weighment_deductions")
}

// ---------------------------------------------------------------------------
// Purchase Order
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id            String   @id @default(uuid())
  orderNumber   String   @unique @db.VarChar(20)
  sellRequestId String   @unique
  issuedAt      DateTime @default(now())
  totalAmount   Decimal  @db.Decimal(12, 2)
  notes         String?  @db.VarChar(1000)

  sellRequest SellRequest @relation(fields: [sellRequestId], references: [id])
  payments    Payment[]

  @@map("purchase_orders")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id              String        @id @default(uuid())
  sellRequestId   String
  purchaseOrderId String?
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(PENDING)
  paymentReference String?      @db.VarChar(200)
  paymentDate     DateTime?
  paymentMethod   String?       @db.VarChar(50) // BANK_TRANSFER, CASH, UPI, etc.
  notes           String?       @db.VarChar(500)
  recordedById    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sellRequest   SellRequest    @relation(fields: [sellRequestId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  recordedBy    User?          @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([sellRequestId])
  @@index([status])
  @@index([paymentDate])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id       String   @id @default(uuid())
  farmerId String
  title    String   @db.VarChar(200)
  body     String   @db.VarChar(1000)
  data     Json?
  isRead   Boolean  @default(false)
  sentAt   DateTime @default(now())

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId, isRead])
  @@index([sentAt])
  @@map("notifications")
}

model DeviceToken {
  id        String   @id @default(uuid())
  farmerId  String
  token     String   @unique @db.VarChar(512)
  platform  String   @default("android") @db.VarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId])
  @@map("device_tokens")
}

// ---------------------------------------------------------------------------
// Audit Log
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String? // null for system actions
  actorType  String   @db.VarChar(20) // USER | SYSTEM | FARMER
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String   @db.VarChar(36)
  before     Json?
  after      Json?
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Company Settings (key-value store for runtime-configurable business data)
// ---------------------------------------------------------------------------

model CompanySettings {
  id        String   @id @default(uuid())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  isPublic  Boolean  @default(false) // true = safe to expose to farmer app
  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

// ---------------------------------------------------------------------------
// Farmer Notes (internal admin notes on a farmer profile)
// ---------------------------------------------------------------------------

model FarmerNote {
  id        String   @id @default(uuid())
  farmerId  String
  authorId  String
  note      String   @db.Text
  createdAt DateTime @default(now())

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([farmerId])
  @@map("farmer_notes")
}
