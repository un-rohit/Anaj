# =============================================================================
# ANAJ — Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file. Commit only this .env.example.
#
# NOTE: The business email below (anajsellkishan01@gamil.com) is preserved
# exactly as supplied. The domain "gamil.com" appears to be a typo for
# "gmail.com". Please verify with the business owner before production use.
# =============================================================================

# --- Database ---
DATABASE_URL="postgresql://anaj_user:CHANGE_ME@localhost:5432/anaj_dev"
# For production use a managed PostgreSQL service (e.g., Supabase, RDS, Neon).

# --- API Server ---
NODE_ENV="development"
PORT=4000
API_BASE_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000,exp://localhost:8081"

# --- JWT Authentication ---
JWT_ACCESS_SECRET="CHANGE_ME_STRONG_RANDOM_SECRET_32_CHARS_MIN"
JWT_REFRESH_SECRET="CHANGE_ME_ANOTHER_STRONG_RANDOM_SECRET"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# --- OTP / SMS ---
# Supported providers: twilio | msg91 | fast2sms
SMS_PROVIDER="fast2sms"
SMS_API_KEY="CHANGE_ME"
SMS_SENDER_ID="ANAJKM"
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- Firebase Cloud Messaging (Push Notifications) ---
FCM_SERVER_KEY="CHANGE_ME"
FCM_PROJECT_ID="CHANGE_ME"
# Path to Firebase service account JSON (used server-side only)
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# --- Object Storage (e.g., AWS S3, Cloudflare R2, MinIO) ---
STORAGE_PROVIDER="s3"
STORAGE_BUCKET="anaj-media"
STORAGE_REGION="ap-south-1"
STORAGE_ACCESS_KEY_ID="CHANGE_ME"
STORAGE_SECRET_ACCESS_KEY="CHANGE_ME"
STORAGE_ENDPOINT=""
# Public base URL for serving stored files
STORAGE_PUBLIC_URL="https://media.anaj.example.com"

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
OTP_RATE_LIMIT_MAX=5

# --- Logging ---
LOG_LEVEL="info"
# Set to "json" for production structured logs, "pretty" for development
LOG_FORMAT="pretty"

# --- Business / Company Settings (defaults; stored in DB after first seed) ---
COMPANY_NAME="ANAJ"
COMPANY_EMAIL="anajsellkishan01@gamil.com"
COMPANY_PHONE="7061654008"
COMPANY_ADDRESS="Navaka Tola, Mairwa, Siwan, Bihar, PIN 841239"

# --- Admin Website (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXTAUTH_SECRET="CHANGE_ME_NEXTAUTH_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# --- Mobile App (Expo) ---
EXPO_PUBLIC_API_URL="http://localhost:4000/api/v1"
