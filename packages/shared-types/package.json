{
  "name": "@anaj/shared-types",
  "version": "1.0.0",
  "private": true,
  "description": "Shared TypeScript types for ANAJ platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@anaj/config": "*",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
